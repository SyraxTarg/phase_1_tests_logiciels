meta {
  name: login
  type: http
  seq: 2
}

post {
  url: http://localhost:3087/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "username": "Alice",
    "password": "password123"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    
    if (data.token) {
      bru.setVar("jwt_token", data.token);
      console.log("Token sauvegardé !");
    }
  }
}
